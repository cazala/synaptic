{
  "name": "synaptic-v2-workspace",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Architecture-free neural networks with portable CPU, WebAssembly, and WebGPU backends",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:wasm && tsc -b",
    "build:wasm": "node packages/backend-wasm/scripts/build.mjs",
    "benchmark:wasm": "node packages/backend-wasm/bench/compare.mjs",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@webgpu/types": "0.1.71",
    "assemblyscript": "0.28.20",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
