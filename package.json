{
  "name": "synaptic-v2-workspace",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Architecture-free neural networks with portable CPU, WebAssembly, and WebGPU backends",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:wasm && tsc -b",
    "build:wasm": "node packages/backend-wasm/scripts/build.mjs",
    "benchmark:wasm": "node packages/backend-wasm/bench/compare.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:webgpu": "node scripts/serve-webgpu-tests.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@cazala/automata": "file:vendor/cazala-automata-0.0.0-development.tgz",
    "@vitest/coverage-v8": "4.1.10",
    "@webgpu/types": "0.1.71",
    "assemblyscript": "0.28.20",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
